{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "888da9a5042432636a916916313bf3f0",
  "minify": true,
  "name": "marionette-docs-mcp",
  "main": "mcp/worker.mjs",
  "compatibility_date": "2026-09-09",
