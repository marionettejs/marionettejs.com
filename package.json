{
  "name": "marionettejs-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marionette website and published beta documentation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "docs:import": "node scripts/import-docs.mjs",
    "vendor:build": "node scripts/build-vendor.mjs",
    "mcp": "node mcp/server.mjs",
    "test:browser": "node test/browser/agent-workshop.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "esbuild": "0.28.2",
    "marionette": "5.0.0-beta.1",
    "marked": "18.0.12",
    "pagefind": "1.5.2",
    "playwright": "1.63.0",
    "zod": "4.5.4"
  }
}
